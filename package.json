{
  "name": "readest-mcp",
  "version": "0.1.1",
  "description": "Read-only MCP for Readest books, annotations and source references.",
  "type": "module",
  "license": "MIT",
  "author": "Gabriele Bettineschi",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbettineschi/readest-mcp.git"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "readest-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "examples"
  ],
  "scripts": {
    "test": "vitest run",
    "pretest": "npm run build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "2.118.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.14",
    "pdfjs-dist": "6.4.299",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yazl": "3.3.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  }
}
